# Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
# Optional: for Better Auth dashboard (dash.better-auth.com)
BETTER_AUTH_API_KEY=

# PostgreSQL (Neon free: neon.tech, or local/Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/reminders
# For production: comma-separated frontend URLs (e.g. https://yourapp.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Public URL of the Next.js app — required in production for email links (verify, invites) and CORS
# FRONTEND_URL=http://localhost:3000
PORT=8000

# Email (Resend) — optional; without RESEND_API_KEY, verification/reset/invite emails are not sent
# RESEND_API_KEY=
# EMAIL_FROM=Dialcues <noreply@yourdomain.com>

# Optional: AI prompt generation in Settings (OpenRouter free tier works)
# OPENROUTER_API_KEY=

# Voice actions (snooze/dismiss during call) - optional
# API_PUBLIC_URL: Backend URL reachable by Vapi (e.g. https://api.yourapp.com). Required for voice actions.
# VOICE_ACTION_SECRET: Secret for signing voice action tokens. Generate: openssl rand -base64 32
# API_PUBLIC_URL=
# VOICE_ACTION_SECRET=

# Blog AI generation — optional; required to use blog draft generation
# AI_PROVIDER: gemini | openrouter (default: gemini)
# AI_MODEL: model identifier (default: gemini-2.0-flash for Gemini, meta-llama/llama-3.1-8b-instruct:free for OpenRouter)
# AI_API_KEY: API key for the chosen provider
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.0-flash
# AI_API_KEY=

# Blog system settings
# BLOG_AUTO_GENERATION_ENABLED: set to "true" to enable cron-based auto-generation
# BLOG_AUTO_PUBLISH: set to "true" to auto-publish generated drafts (default: false, draft-first)
# BLOG_CRON_SECRET: secret for securing the /api/blog/cron/generate-daily endpoint
# BLOG_ADMIN_EMAILS: comma-separated emails allowed to access blog admin (e.g. you@example.com)
# BLOG_ADMIN_USER_IDS: comma-separated user IDs allowed to access blog admin (alternative to emails)
# BLOG_AUTO_GENERATION_ENABLED=false
# BLOG_AUTO_PUBLISH=false
# BLOG_CRON_SECRET=
# BLOG_ADMIN_EMAILS=
# BLOG_ADMIN_USER_IDS=
