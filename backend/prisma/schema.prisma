generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth
model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime? // Updated by Better Auth dash plugin when activity tracking is enabled
  sessions            Session[]
  accounts            Account[]
  reminders           Reminder[]
  reminderExecutions  ReminderExecution[]
  reminderTemplates   ReminderTemplate[]
  settings            UserSettings?
  vapiConfigs         VapiConfig[]
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("account")
}

// User settings row (legacy Vapi fields migrated to VapiConfig on first load)
model UserSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  vapiApiKey        String?
  vapiPhoneNumberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_settings")
}

/// Named Vapi account: one API key, many outbound numbers (each validated).
model VapiConfig {
  id         String            @id @default(cuid())
  userId     String            @map("user_id")
  name       String            @db.VarChar(100)
  vapiApiKey String            @map("vapi_api_key") @db.Text
  isDefault  Boolean           @default(false) @map("is_default")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  numbers    VapiPhoneNumber[]

  @@index([userId])
  @@map("vapi_configs")
}

model VapiPhoneNumber {
  id                String     @id @default(cuid())
  vapiConfigId      String     @map("vapi_config_id")
  vapiPhoneNumberId String     @map("vapi_phone_number_id") @db.VarChar(255)
  nickname          String     @db.VarChar(100)
  isDefault         Boolean    @default(false) @map("is_default")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  config            VapiConfig @relation(fields: [vapiConfigId], references: [id], onDelete: Cascade)
  reminders         Reminder[]

  @@unique([vapiConfigId, vapiPhoneNumberId])
  @@index([vapiConfigId])
  @@map("vapi_phone_numbers")
}

model Reminder {
  id                Int                 @id @default(autoincrement())
  userId            String
  title             String              @db.VarChar(255)
  message           String              @db.VarChar(1000)
  phone_number      String              @db.VarChar(20)
  scheduled_at      DateTime            @db.Timestamptz
  timezone          String              @db.VarChar(50)
  status            String              @default("scheduled") @db.VarChar(20)
  call_id             String?             @db.VarChar(255)
  error_message       String?             @db.VarChar(500)
  retry_count         Int                 @default(0)
  recurrence_type     String?             @db.VarChar(20)
  recurrence_config   String?             @db.VarChar(200)
  recurrence_end_at   DateTime?           @db.Timestamptz
  vapiLineId          String?             @map("vapi_line_id")
  created_at          DateTime            @default(now())
  updated_at        DateTime?           @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vapiLine          VapiPhoneNumber?    @relation(fields: [vapiLineId], references: [id], onDelete: SetNull)
  executions        ReminderExecution[]
  @@index([vapiLineId])
  @@map("reminders")
}

model ReminderExecution {
  id            Int       @id @default(autoincrement())
  reminderId    Int
  userId        String
  scheduled_at  DateTime  @db.Timestamptz
  status        String    @db.VarChar(20) // completed | failed
  call_id       String?   @db.VarChar(255)
  error_message String?   @db.VarChar(500)
  /// Transcript, messages, recording URLs, etc. (from Vapi end-of-call-report or sync)
  call_details  Json?
  executed_at   DateTime  @default(now())
  reminder      Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("reminder_executions")
}

model ReminderTemplate {
  id         Int      @id @default(autoincrement())
  userId     String
  title      String   @db.VarChar(255)
  message    String   @db.VarChar(1000)
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("reminder_templates")
}
