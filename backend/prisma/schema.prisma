generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Better Auth
model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastActiveAt  DateTime? // Updated by Better Auth dash plugin when activity tracking is enabled
  sessions            Session[]
  accounts            Account[]
  reminders           Reminder[]
  reminderExecutions  ReminderExecution[]
  memberships         Member[]
  teamMemberships     TeamMember[]
  invitationsSent     Invitation[]       @relation("InvitationInviter")
  publicApiKeys       PublicApiKey[]
  publicApiRequests   PublicApiRequest[]
  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  activeOrganizationId String?
  activeTeamId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@map("account")
}

model Organization {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  logo        String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime?     @updatedAt
  members     Member[]
  teams       Team[]
  invitations Invitation[]
  promptProfile PromptProfile?
  vapiConfigs VapiConfig[]
  reminderTemplates ReminderTemplate[]
  publicApiKeys PublicApiKey[]
  publicApiRequests PublicApiRequest[]

  @@map("organization")
}

model PublicApiKey {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  name           String       @db.VarChar(100)
  keyPrefix      String       @map("key_prefix") @db.VarChar(20)
  keyHash        String       @map("key_hash") @db.VarChar(64)
  lastUsedAt     DateTime?    @map("last_used_at")
  expiresAt      DateTime?    @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       PublicApiRequest[]

  @@unique([keyHash])
  @@index([organizationId])
  @@index([userId])
  @@index([revokedAt])
  @@map("public_api_keys")
}

model PublicApiRequest {
  id             Int          @id @default(autoincrement())
  publicApiKeyId String       @map("public_api_key_id")
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  method         String       @db.VarChar(8)
  path           String       @db.VarChar(180)
  statusCode     Int          @map("status_code")
  durationMs     Int          @map("duration_ms")
  errorCode      String?      @map("error_code") @db.VarChar(80)
  createdAt      DateTime     @default(now()) @map("created_at")
  apiKey         PublicApiKey @relation(fields: [publicApiKeyId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publicApiKeyId, createdAt])
  @@index([organizationId, createdAt])
  @@index([statusCode, createdAt])
  @@index([path, createdAt])
  @@map("public_api_requests")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Team {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  invitations    Invitation[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  teamId         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

/// Named Vapi account: one API key, many outbound numbers (each validated). Org-scoped (shared by all members).
model VapiConfig {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String         @db.VarChar(100)
  vapiApiKey     String         @map("vapi_api_key") @db.Text
  isDefault      Boolean        @default(false) @map("is_default")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numbers        VapiPhoneNumber[]

  @@index([organizationId])
  @@map("vapi_configs")
}

model VapiPhoneNumber {
  id                String     @id @default(cuid())
  vapiConfigId      String     @map("vapi_config_id")
  vapiPhoneNumberId String     @map("vapi_phone_number_id") @db.VarChar(255)
  nickname          String     @db.VarChar(100)
  isDefault         Boolean    @default(false) @map("is_default")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  config            VapiConfig @relation(fields: [vapiConfigId], references: [id], onDelete: Cascade)
  reminders         Reminder[]

  @@unique([vapiConfigId, vapiPhoneNumberId])
  @@index([vapiConfigId])
  @@map("vapi_phone_numbers")
}

model Reminder {
  id                Int                 @id @default(autoincrement())
  userId            String
  title             String              @db.VarChar(255)
  message           String              @db.VarChar(1000)
  phone_number      String              @db.VarChar(20)
  scheduled_at      DateTime            @db.Timestamptz
  timezone          String              @db.VarChar(50)
  status            String              @default("scheduled") @db.VarChar(20)
  call_id             String?             @db.VarChar(255)
  error_message       String?             @db.VarChar(500)
  retry_count         Int                 @default(0)
  recurrence_type     String?             @db.VarChar(20)
  recurrence_config   String?             @db.VarChar(200)
  recurrence_end_at   DateTime?           @db.Timestamptz
  vapiLineId          String?             @map("vapi_line_id")
  created_at          DateTime            @default(now())
  updated_at        DateTime?           @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vapiLine          VapiPhoneNumber?    @relation(fields: [vapiLineId], references: [id], onDelete: SetNull)
  executions        ReminderExecution[]
  @@index([vapiLineId])
  @@map("reminders")
}

model ReminderExecution {
  id            Int       @id @default(autoincrement())
  reminderId    Int
  userId        String
  scheduled_at  DateTime  @db.Timestamptz
  status        String    @db.VarChar(20) // completed | failed
  call_id       String?   @db.VarChar(255)
  error_message String?   @db.VarChar(500)
  /// Transcript, messages, recording URLs, etc. (from Vapi end-of-call-report or sync)
  call_details  Json?
  executed_at   DateTime  @default(now())
  reminder      Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("reminder_executions")
}

model ReminderTemplate {
  id             Int          @id @default(autoincrement())
  organizationId String
  title          String       @db.VarChar(255)
  message        String       @db.VarChar(1000)
  created_at     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("reminder_templates")
}

model PromptProfile {
  id              String   @id @default(cuid())
  organizationId  String   @unique @map("organization_id")
  mode            String   @default("default") @db.VarChar(20) // default | custom | generated
  customPrompt    String?  @map("custom_prompt") @db.Text
  generatedPrompt String?  @map("generated_prompt") @db.Text
  businessName    String?  @map("business_name") @db.VarChar(120)
  industry        String?  @db.VarChar(120)
  tone            String?  @db.VarChar(60)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("prompt_profiles")
}
