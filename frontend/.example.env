NEXT_PUBLIC_API_URL=http://localhost:8000

# Production: your deployed frontend origin (used for auth emails, password reset redirects, etc.)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Blog admin: comma-separated emails that can access /admin/blog (must match BLOG_ADMIN_EMAILS in backend)
# NEXT_PUBLIC_BLOG_ADMIN_EMAILS=

# Blog cron: must match BLOG_CRON_SECRET in backend (used by Vercel cron to call backend)
# BLOG_CRON_SECRET=
